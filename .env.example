SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon-or-publishable-key>

# Local debugging only ("Dev: entrar como…" widget and /api/dev routes). The service-role key
# bypasses RLS: keep it out of any deployed environment.
NUXT_SUPABASE_SECRET_KEY=<service-role-or-secret-key>

# Commentary endpoint (GET /api/commentary/runway): bearer token the AI skill sends.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable the endpoint. It reads with the service-role key above.
NUXT_COMMENTARY_API_TOKEN=
