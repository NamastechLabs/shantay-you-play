{
  "name": "shantay-you-play",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:local": "nuxt dev --dotenv .env.local",
    "db:start": "pnpm dlx supabase start -x studio,imgproxy,vector,logflare,edge-runtime,mailpit",
    "db:stop": "pnpm dlx supabase stop",
    "tunnel:app": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:api": "cloudflared tunnel --url http://localhost:54321",
    "db:reset": "pnpm dlx supabase db reset",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.1.0",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "sass": "^1.107.1",
    "typescript": "~5.9",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=9.15.9"
  },
  "packageManager": "pnpm@9.15.9"
}
